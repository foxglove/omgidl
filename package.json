{
  "name": "@foxglove/omg-support",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": {
    "name": "Foxglove",
    "email": "contact@foxglove.dev",
    "url": "https://foxglove.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxglove/omgidl.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "yarn workspaces foreach --all run clean",
    "test": "yarn test:dependencies && yarn workspaces foreach --all run test --color",
    "test:dependencies": "node --test test/*.test.cjs",
    "lint": "eslint --fix test && yarn workspaces foreach --all run lint --color",
    "lint:ci": "eslint test && yarn workspaces foreach --all run lint:ci",
    "build": "yarn workspaces foreach --all run build",
    "parser:test": "yarn workspace @foxglove/omgidl-parser test",
    "parser:build": "yarn workspace @foxglove/omgidl-parser build",
    "serde:test": "yarn workspace @foxglove/omgidl-serialization test",
    "serde:build": "yarn workspace @foxglove/omgidl-serialization build",
    "ros2idl:test": "yarn workspace @foxglove/ros2idl-parser test",
    "ros2idl:build": "yarn workspace @foxglove/ros2idl-parser build"
  },
  "devDependencies": {
    "@foxglove/eslint-plugin": "2.1.0",
    "@types/jest": "29.5.14",
    "eslint": "9.29.0",
    "globals": "17.3.0",
    "jest": "29.7.0",
    "prettier": "3.7.4",
    "ts-jest": "29.4.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.2"
  },
  "resolutions": {
    "minimatch@npm:^10.2.2": "11.0.1",
    "tar": ">=7.5.21",
    "undici": "^6.29.1",
    "deepmerge@npm:^4.2.2": "patch:deepmerge@npm%3A4.3.1#~/.yarn/patches/deepmerge-npm-4.3.1-4f751a0844.patch"
  },
  "jest": {
    "projects": [
      "packages/omgidl-parser/jest.config.js",
      "packages/omgidl-serialization/jest.config.js",
      "packages/ros2idl-parser/jest.config.js"
    ]
  },
  "packageManager": "yarn@4.12.0"
}
